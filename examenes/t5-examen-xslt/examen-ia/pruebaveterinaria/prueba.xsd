<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

<xs:element name="prueba">

    <xs:complexType>

        <xs:sequence>

            <xs:element name="consulta" maxOccurs="unbounded">

                <xs:complexType>

                    <xs:sequence>

                        <xs:element name="codigo" type="xs:string"/>

                        <xs:element name="mascota">

                            <xs:complexType mixed="true">

                                <xs:attribute name="tipo" type="xs:string" use="required"/>

                            </xs:complexType>

                        </xs:element>

                        <xs:element name="edad" type="xs:integer"/>

                        <xs:element name="fecha" type="xs:date"/>

                        <xs:element name="prioridad" type="xs:string"/>

                        <xs:element name="procedimientos">

                            <xs:complexType>

                                <xs:sequence>

                                    <xs:element name="procedimiento" maxOccurs="unbounded">

                                        <xs:complexType>

                                            <xs:sequence>

                                                <xs:element name="descripcion" type="xs:string"/>

                                                <xs:element name="precio" type="xs:decimal"/>

                                            </xs:sequence>

                                        </xs:complexType>

                                    </xs:element>

                                </xs:sequence>

                            </xs:complexType>

                        </xs:element>

                    </xs:sequence>

                    <xs:attribute name="revision" type="xs:string"/>

                </xs:complexType>

            </xs:element>

        </xs:sequence>

    </xs:complexType>

</xs:element>

</xs:schema>